{
  "manifest_version": 3,
  "name": "Tutorial Extension",
  "version": "1.0.0",
  "description": "A basic extension created using a youtube tutorial",
  "icons": {
    "128": "images/logo.jpg"
  }
  , "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"

  ]

}